     json view()const{std::lock_guard<std::mutex> lock(mutex);return doc;}
+    static std::string revision(const json &value){
+        const auto text=value.dump();unsigned char hash[SHA256_DIGEST_LENGTH];
+        SHA256(reinterpret_cast<const unsigned char *>(text.data()),text.size(),hash);
+        static const char hex[]="0123456789abcdef";std::string result;
+        for(auto c:hash){result+=hex[c>>4];result+=hex[c&15];}return result;
+    }
+    json prepare_slots(const json &add,const json &remove,const std::string &expected){
+        if(!add.is_array()||!remove.is_array()||add.size()>64||remove.size()>64)
+            throw std::runtime_error("invalid_slot_batch");
+        std::lock_guard<std::mutex> lock(mutex);
+        if(expected!=revision(doc)||read_json(file)!=doc)throw std::runtime_error("settings_changed");
+        auto next=doc;std::set<std::string> retired,ids;
+        for(const auto &idvalue:remove){
+            if(!idvalue.is_string())throw std::runtime_error("invalid_retired_slot");
+            const auto id=idvalue.get<std::string>();const auto &entry=find(id);
+            if(!retired.insert(id).second||id==doc.value("selected",std::string())||id==doc.value("previous",std::string())
+                ||!entry.value("project_session",false)
+                ||(entry.value("conversation_id",std::string()).empty()&&entry.value("voice_session_id",std::string()).empty()))
+                throw std::runtime_error("protected_slot");
+        }
+        next["chats"]=json::array();
+        for(const auto &entry:doc["chats"]){
+            const auto id=entry.at("id").get<std::string>();
+            if(!ids.insert(id).second)throw std::runtime_error("duplicate_existing_slot");
+            if(!retired.count(id))next["chats"].push_back(entry);
+        }
+        static const std::set<std::string> allowed={"id","gizmo_id","title","project_session",
+            "conversation_id","parent_message_id","voice_session_id","account_id","confirmed"};
+        for(const auto &entry:add){
+            if(!entry.is_object())throw std::runtime_error("invalid_new_slot");
+            for(auto i=entry.begin();i!=entry.end();++i)if(!allowed.count(i.key()))throw std::runtime_error("invalid_slot_field");
+            const auto id=entry.at("id").get<std::string>(),project=entry.at("gizmo_id").get<std::string>();
+            bool valid=id.size()==36;
+            for(size_t i=0;i<id.size()&&valid;++i)valid=(i==8||i==13||i==18||i==23)?id[i]=='-':std::string("0123456789abcdef").find(id[i])!=std::string::npos;
+            if(!valid||!ids.insert(id).second||project.size()>128||project.size()<=4||project.rfind("g-p-",0)!=0
+                ||project.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_")!=std::string::npos
+                ||!entry.value("project_session",false)||entry.value("confirmed",false))throw std::runtime_error("invalid_new_slot");
+            for(const char *key:{"conversation_id","parent_message_id","voice_session_id","account_id"})
+                if(!entry.value(key,std::string()).empty())throw std::runtime_error("new_slot_not_empty");
+            const auto title=entry.at("title").get<std::string>();
+            if(title.empty()||title.size()>120||title.find_first_of("\r\n\t")!=std::string::npos)throw std::runtime_error("invalid_title");
+            next["chats"].push_back(entry);
+        }
+        if(next["chats"].size()>64)throw std::runtime_error("chat_limit");
+        // Commit disk first: a failed write must leave the in-memory voice state intact.
+        write_json(file,next);doc.swap(next);
+        return {{"ok",true},{"settings_revision",revision(doc)}};
+    }
     void voice(std::string value){
         static const std::set<std::string> allowed={"breeze","cove","ember","fathom","glimmer","juniper","maple","orbit","vale"};
         if(value=="arbor")value="fathom";if(value=="sol")value="glimmer";if(value=="spruce")value="orbit";
